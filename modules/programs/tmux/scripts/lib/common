#!/usr/bin/env bash

# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/logging"

project_for_path() {
	local path="$1" root superproject
	case "$path" in
	"~") path="$HOME" ;;
	"~/"*) path="$HOME/${path#"~/"}" ;;
	esac
	if [[ -d "$path" ]]; then
		root="${path%/}"
		[[ -n "$root" ]] || root="/"
		while :; do
			if [[ -f "$root/.root" ]]; then
				printf '%s\n' "$root"
				return
			fi
			[[ "$root" == "/" ]] && break
			root="${root%/*}"
			[[ -n "$root" ]] || root="/"
		done

		root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)"
		while [[ -n "$root" ]]; do
			superproject="$(git -C "$root" rev-parse --show-superproject-working-tree 2>/dev/null)"
			[[ -n "$superproject" ]] || break
			root="$superproject"
		done
		printf '%s\n' "${root:-$path}"
	else
		printf '%s\n' "$path"
	fi
}

# Same normalization as tmux-customize tmcResolveGroup: popup sessions are
# named _popup_<id>_[git_root_|root_]<name>_<encoded-path>.
session_matches() {
	local session="$1" name="$2" logical
	[[ "$session" == "$name" || "$session" == "${name}_"* ]] && return 0
	logical="${session#_popup_}"
	[[ "$logical" == "$session" ]] && return 1
	logical="${logical#*_}"
	logical="${logical#git_root_}"
	logical="${logical#root_}"
	[[ "$logical" == "$name" || "$logical" == "${name}_"* ]]
}

label_for_cmd() {
	local cmd="$1"
	cmd="${cmd%% *}"
	cmd="${cmd##*/}"
	cmd="${cmd#-}"
	printf '%s\n' "${cmd:-shell}"
}

# --- batch tmux IPC helpers -----------------------------------------------
# Accumulate multiple tmux commands and flush them in a single IPC call
# instead of spawning a separate tmux client process for each one.
#
# Usage:
#   tmux_begin                       # start a new batch
#   tmux_add set-option -p ...       # queue a command
#   tmux_add set-option -w ...       # queue another
#   tmux_refresh_clients             # refresh all current clients
#   tmux_flush                       # fire everything in one tmux call
_TMUX_BATCH=()
_TMUX_LOCK_FD=""

tmux_lock() {
	local name="$1" timeout_seconds="${2:-}" server_pid lock_dir lock_path
	server_pid="$("${TMUX_BIN:-tmux}" display-message -p '#{pid}' 2>/dev/null)" || return 1
	[[ "$server_pid" =~ ^[0-9]+$ ]] || return 1
	name="${name//[^[:alnum:]_.-]/_}"
	lock_dir="${TMPDIR:-/tmp}/tmux-locks-$UID"
	lock_path="$lock_dir/$server_pid-$name.lock"
	umask 077
	mkdir -p "$lock_dir" || return 1
	exec {_TMUX_LOCK_FD}>"$lock_path" || return 1
	if [[ -n "$timeout_seconds" ]]; then
		flock -w "$timeout_seconds" "$_TMUX_LOCK_FD" || {
			exec {_TMUX_LOCK_FD}>&-
			_TMUX_LOCK_FD=""
			return 1
		}
	else
		flock "$_TMUX_LOCK_FD" || {
			exec {_TMUX_LOCK_FD}>&-
			_TMUX_LOCK_FD=""
			return 1
		}
	fi
	trap tmux_unlock EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
}

tmux_unlock() {
	[[ "${_TMUX_LOCK_FD:-}" =~ ^[0-9]+$ ]] || return 0
	flock -u "$_TMUX_LOCK_FD" >/dev/null 2>&1 || true
	exec {_TMUX_LOCK_FD}>&-
	_TMUX_LOCK_FD=""
	trap - EXIT HUP INT TERM
}

# Close an inherited descriptor without releasing the parent's lock.
tmux_lock_close() {
	[[ "${_TMUX_LOCK_FD:-}" =~ ^[0-9]+$ ]] || return 0
	exec {_TMUX_LOCK_FD}>&-
	_TMUX_LOCK_FD=""
}

tmux_begin() {
	_TMUX_BATCH=()
}

tmux_add() {
	((${#_TMUX_BATCH[@]})) && _TMUX_BATCH+=(';')
	_TMUX_BATCH+=("$@")
}

tmux_refresh_clients() {
	local client session window target
	local -A sessions=() windows=()
	local -a commands=()
	for target in "$@"; do
		case "$target" in
		\$*) sessions[$target]=1 ;;
		@*) windows[$target]=1 ;;
		esac
	done
	if ((${#windows[@]})); then
		while read -r session window; do
			[[ -z "${windows[$window]:-}" ]] || sessions[$session]=1
		done < <(tmux list-windows -a -F '#{session_id} #{window_id}' 2>/dev/null)
	fi
	while IFS=$'\x1f' read -r client session; do
		[[ -n "$client" ]] || continue
		(($# == 0)) || [[ -n "${sessions[$session]:-}" ]] || continue
		((${#commands[@]} == 0)) || commands+=(';')
		commands+=(refresh-client -S -t "$client")
	done < <(tmux list-clients -F $'#{client_tty}\x1f#{session_id}' 2>/dev/null)
	((${#commands[@]})) || return 0
	tmux "${commands[@]}"
}

tmux_flush_if() {
	local target="$1" condition="$2" command="" argument
	for argument in "${_TMUX_BATCH[@]}"; do
		if [[ "$argument" == ";" ]]; then
			command+=" ; "
			continue
		fi
		argument="${argument//\\/\\\\}"
		argument="${argument//\"/\\\"}"
		argument="${argument//\$/\\\$}"
		command+="\"$argument\" "
	done
	_TMUX_BATCH=()
	[[ "$(tmux if-shell -F -t "$target" "$condition" "$command ; display-message -p 1")" == 1 ]]
}

tmux_flush() {
	local status=0
	((${#_TMUX_BATCH[@]})) || return 0
	tmux "${_TMUX_BATCH[@]}" >/dev/null 2>&1 || status=$?
	if ((status)) && [[ -n "${TMUX_LOG_COMPONENT:-}" ]]; then
		tmux_log error batch_failed "operation=${_TMUX_BATCH[0]}" "exit_code=$status"
	fi
	_TMUX_BATCH=()
	return "$status"
}
