#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$script_dir/../../../scripts/lib/common"
if ! tmux_lock __popup_lock__popup_all_agents 2; then
	tmux display-message "agent overview: busy"
	exit 0
fi

session="_popup_all_agents"

inner="$(tmux display-message -p '#{client_name}' 2>/dev/null)" || inner=""
outer="${TMUX_MENU_CLIENT:-$inner}"
if [[ -z "$outer" ]] || ! tmux list-clients -F '#{client_name}' | grep -qxF "$outer"; then
	tmux display-message "agent overview: owner client not found"
	exit 0
fi

if tmux list-clients -t "$session" -F '#{client_name}' 2>/dev/null | grep -q .; then
	tmux display-message "agent overview is already open on another client"
	exit 0
fi

if tmux has-session -t "$session" 2>/dev/null &&
! error=$(tmux kill-session -t "$session" 2>&1); then
	if tmux has-session -t "$session" 2>/dev/null; then
		printf '%s\n' "$error" >&2
		exit 1
	fi
fi

mapfile -t windows < <(
	tmux list-panes -a -F $'#{window_id}\x1f#{@agent_enabled}' 2>/dev/null |
	awk -F $'\x1f' '$2 == "1" && !seen[$1]++ { print $1 }'
)

if ((${#windows[@]} == 0)); then
	tmux display-message "No AI agents"
	exit 0
fi

owned_session="$(tmux new-session -dP -F '#{session_id}' -s "$session" \
	-e TMUX_AGENT_STATUS=1 \
	-e TMUX_TITLE_OWNER=agent \
	-e TMUX_POPUP_KEEP_OPEN=1 \
	-e CTRL_C_AS_CLOSE=1 \
	-e TMUX_REMAP_CTRL_D=C-n)"
launching=0
popup_pid=""
cleanup_overview() {
	if [[ -z "${_TMUX_LOCK_FD:-}" ]]; then
		tmux_lock __popup_lock__popup_all_agents || return
	fi
	if ((launching)); then
		tmux kill-session -t "$owned_session" 2>/dev/null || true
		tmux display-popup -C -c "$outer" 2>/dev/null || true
		[[ -z "$popup_pid" ]] || wait "$popup_pid" || true
	elif [[ -z "$(tmux list-clients -t "$owned_session" -F '#{client_name}' 2>/dev/null)" ]]; then
		tmux kill-session -t "$owned_session" 2>/dev/null || true
	fi
	tmux_unlock
}
trap cleanup_overview EXIT
tmux_begin
tmux_add set-option -t "$session" prefix None
tmux_add set-option -t "$session" key-table all-agents-root
tmux_flush

placeholder="$(tmux list-windows -t "$session" -F '#{window_id}')"
linked=0
for window in "${windows[@]}"; do
	if tmux link-window -d -s "$window" -t "$session:" 2>/dev/null; then
		((linked += 1))
	fi
done

if ((linked == 0)); then
	tmux kill-session -t "$session"
	tmux display-message "No AI agents"
	exit 0
fi

tmux kill-window -t "$placeholder"

default_width="$(tmux show-options -gqv @popup_default_width)"
default_height="$(tmux show-options -gqv @popup_default_height)"
default_width="${default_width:-75%}"
default_height="${default_height:-70%}"
geom="$(tmux show-options -gqv @popup_geom__popup_all_agents)"
if [[ -n "$geom" ]]; then
	read -r x y w h < <(printf '%s\n' "$geom")
else
	x=C
	y=C
	w="$default_width"
	h="$default_height"
fi

tmux_begin
tmux_add set -g @popup_client__popup_all_agents "$outer"
tmux_add set -g @popup_default_geom__popup_all_agents "C C $default_width $default_height"
tmux_add set -g @popup_border__popup_all_agents single
tmux_add display-popup -C -c "$outer"
tmux_flush
if [[ -n "$inner" && "$inner" != "$outer" ]]; then
	for _ in {1..20}; do
		! tmux list-clients -F '#{client_name}' | grep -qxF "$inner" && break
		sleep 0.05
	done
fi
attach=(tmux attach -t "$owned_session")
last_target="$(tmux show-options -sqv @agent_overview_last)"
if [[ "$last_target" =~ ^@[0-9]+\.%[0-9]+$ ]] &&
[[ "$(tmux display-message -pt "$session:$last_target" '#{@agent_enabled}' 2>/dev/null)" == 1 ]]; then
	attach+=(
		';' select-window -t "$session:${last_target%%.*}"
		';' select-pane -t "$session:$last_target"
	)
fi
printf -v attach_command '%q ' "${attach[@]}"

# Keep the lock until attach registers so another opener cannot replace this session.
launching=1
(
	trap - EXIT HUP INT TERM
	tmux_lock_close
	exec tmux display-popup -c "$outer" -x "$x" -y "$y" -w "$w" -h "$h" \
		-b single -E "$attach_command"
) &
popup_pid=$!
for _ in {1..20}; do
	if [[ -n "$(tmux list-clients -t "$owned_session" -F '#{client_name}' 2>/dev/null)" ]]; then
		launching=0
		break
	fi
	sleep 0.05
done
((launching == 0)) || exit 1

tmux_unlock || exit
trap cleanup_overview EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

status=0
wait "$popup_pid" || status=$?
[[ "$status" -eq 0 || "$status" -eq 129 ]]
