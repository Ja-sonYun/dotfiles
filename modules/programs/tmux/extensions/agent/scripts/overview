#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$script_dir/../../../scripts/lib/common"
export TMUX_LOG_COMPONENT=tmux.agent.overview
if ! tmux_lock __popup_lock__popup_all_agents 2; then
	tmux display-message "agent overview: busy"
	tmux_log warning busy
	exit 0
fi

session="_popup_all_agents"

inner="$(tmux display-message -p '#{client_name}' 2>/dev/null)" || inner=""
outer="${TMUX_MENU_CLIENT:-$inner}"
seen_clients=()
while [[ -n "$outer" ]]; do
	for seen in "${seen_clients[@]}"; do
		if [[ "$seen" == "$outer" ]]; then
			tmux display-message "agent overview: popup owner cycle"
			tmux_log error owner_cycle "client=$outer"
			exit 1
		fi
	done
	seen_clients+=("$outer")
	outer_session="$(tmux list-clients -F $'#{client_name}\t#{session_name}' |
		awk -F '\t' -v client="$outer" '$1 == client { print $2; exit }')"
	if [[ -z "$outer_session" ]]; then
		outer=""
		break
	fi
	[[ "$outer_session" == popup || "$outer_session" == _popup_* ]] || break
	key="${outer_session//[^A-Za-z0-9]/_}"
	outer="$(tmux show-options -gqv "@popup_client_$key")"
done
if [[ -z "$outer" ]] || ! tmux list-clients -F '#{client_name}' | grep -qxF "$outer"; then
	tmux display-message "agent overview: owner client not found"
	tmux_log warning owner_missing "client=$outer"
	exit 1
fi

if tmux list-clients -t "$session" -F '#{client_name}' 2>/dev/null | grep -q .; then
	tmux display-message "agent overview is already open on another client"
	exit 0
fi

if tmux has-session -t "$session" 2>/dev/null; then
	stale_view="$(tmux show-option -qv -t "$session" @agent_dashboard_view 2>/dev/null)" || stale_view=""
	if [[ -n "$stale_view" ]]; then
		tmux kill-session -t "$stale_view" 2>/dev/null || true
	fi
	if ! error=$(tmux kill-session -t "$session" 2>&1); then
		if tmux has-session -t "$session" 2>/dev/null; then
			tmux_log error cleanup_failed "session=$session" "stderr=${error:0:8192}"
			printf '%s\n' "$error" >&2
			exit 1
		fi
	fi
fi

owned_session="$(tmux_log_run new-session -dP -F '#{session_id}' -s "$session" \
	-e TMUX_AGENT_STATUS= \
	-e TMUX_TITLE_OWNER= \
	-e STATE_COMMAND_NOTIFY= \
	-e TMUX_AGENT_DASHBOARD=1 \
	-e TMUX_POPUP_KEEP_OPEN=1 \
	-e CTRL_C_AS_CLOSE=1 'exec sleep infinity')"
tmux_log info session_created "session_id=$owned_session" "client=$outer"
launching=0
popup_pid=""
cleanup_overview() {
	local result=$? level=info
	((result == 0 || result == 129 || result == 130 || result == 143)) || level=error
	tmux_log "$level" overview_closed "session_id=$owned_session" "exit_code=$result"
	if ((launching)); then
		tmux display-popup -C -c "$outer" 2>/dev/null || true
		[[ -z "$popup_pid" ]] || wait "$popup_pid" || true
	fi
	tmux_unlock
	"$script_dir/overview-finish" "$owned_session"
}
trap cleanup_overview EXIT
tmux_begin
tmux_add set-option -t "$session" prefix None
tmux_add set-option -t "$session" key-table all-agents-root
tmux_add set-option -t "$session" mouse on
tmux_add set-option -t "$session" status off
tmux_add set-option -t "$session" @agent_dashboard_origin "$PWD"
tmux_add set-option -t "$session" @agent_dashboard_origin_pane "${TMUX_MENU_ORIGIN_PANE:-${TMUX_PANE:-}}"
tmux_add set-option -t "$session" @agent_dashboard_origin_window "${TMUX_MENU_ORIGIN_WINDOW:-}"
tmux_add set-option -t "$session" @agent_dashboard_outer "$outer"
tmux_flush

sidebar="$(tmux display-message -pt "$owned_session:" '#{pane_id}')"
socket="$(tmux display-message -p '#{socket_path}')"
dashboard="$(tmux show-option -gqv @agent_dashboard_command)"
printf -v dashboard_command '%q ' "$dashboard" "$socket" "$owned_session" serve "$sidebar"
tmux set-window-option -t "$owned_session:" remain-on-exit off
tmux respawn-pane -k -t "$sidebar" "$dashboard_command"

default_width="$(tmux show-options -gqv @popup_default_width)"
default_height="$(tmux show-options -gqv @popup_default_height)"
default_width="${default_width:-75%}"
default_height="${default_height:-70%}"
geom="$(tmux show-options -gqv @popup_geom__popup_all_agents)"
if [[ -n "$geom" ]]; then
	read -r x y w h < <(printf '%s\n' "$geom")
else
	x=C
	y=C
	w="$default_width"
	h="$default_height"
fi

tmux_begin
tmux_add set -g @popup_client__popup_all_agents "$outer"
tmux_add set -g @popup_default_geom__popup_all_agents "C C $default_width $default_height"
tmux_add set -g @popup_border__popup_all_agents single
tmux_add display-popup -C -c "$outer"
tmux_flush
if [[ -n "$inner" && "$inner" != "$outer" ]]; then
	for _ in {1..20}; do
		! tmux list-clients -F '#{client_name}' | grep -qxF "$inner" && break
		sleep 0.05
	done
fi
attach=(tmux attach -t "$owned_session")
printf -v attach_command '%q ' "${attach[@]}"

# Keep the lock until attach registers so another opener cannot replace this session.
launching=1
(
	trap - EXIT HUP INT TERM
	tmux_lock_close
	exec tmux display-popup -c "$outer" -x "$x" -y "$y" -w "$w" -h "$h" \
		-b single -E "$attach_command"
) &
popup_pid=$!
for _ in {1..20}; do
	if [[ -n "$(tmux list-clients -t "$owned_session" -F '#{client_name}' 2>/dev/null)" ]]; then
		launching=0
		break
	fi
	sleep 0.05
done
((launching == 0)) || exit 1
tmux_log info overview_opened "session_id=$owned_session" "client=$outer"

tmux_unlock || exit
trap cleanup_overview EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

status=0
wait "$popup_pid" || status=$?
[[ "$status" -eq 0 || "$status" -eq 129 ]]
