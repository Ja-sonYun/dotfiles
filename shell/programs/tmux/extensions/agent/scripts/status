#!/usr/bin/env bash

state="${1:-}"
pane_id="${2:-${TMUX_PANE:-}}"
session_id_hint="${3:-}"

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/../../../scripts/lib/common"

schedule_counts() {
	"$script_dir/counts" >/dev/null 2>&1 &
}

resolve_session_id() {
	local owner id candidate name
	owner="$(tmux show-option -pqv -t "$pane_id" @agent_session_id 2>/dev/null)"
	if [[ -n "$owner" ]] && tmux has-session -t "$owner" 2>/dev/null; then
		printf '%s\n' "$owner"
		return
	fi
	if [[ -n "$session_id_hint" ]]; then
		name="$(tmux display-message -pt "$session_id_hint:" '#{session_name}' 2>/dev/null)"
		if session_matches "$name" agent; then
			printf '%s\n' "$session_id_hint"
			return
		fi
	fi
	while IFS=$'\x1f' read -r id candidate name; do
		[[ "$id" == "$pane_id" ]] || continue
		if session_matches "$name" agent; then
			printf '%s\n' "$candidate"
			return
		fi
	done < <(tmux list-panes -a -F $'#{pane_id}\x1f#{session_id}\x1f#{session_name}' 2>/dev/null)
	if [[ -n "$session_id_hint" ]]; then
		printf '%s\n' "$session_id_hint"
	else
		tmux display-message -pt "$pane_id" '#{session_id}' 2>/dev/null
	fi
}

detect_agent() {
	local word base
	for word in "$@"; do
		for word in $word; do
			base="${word##*/}"
			base="${base%\"}"
			base="${base#\"}"
			case "$base" in
				codex | codex-*) printf 'codex\n'; return ;;
				claude | claude-*) printf 'claude\n'; return ;;
				pi | pi-*) printf 'pi\n'; return ;;
			esac
		done
	done
}

clear_pane_state() {
	local target="$1"
	tmux display-message -pt "$target" '#{pane_id}' >/dev/null 2>&1 || return 0
	tmux_begin
	tmux_add set-option -p -q -u -t "$target" @agent_enabled
	tmux_add set-option -p -q -u -t "$target" @agent_state
	tmux_add set-option -p -q -u -t "$target" @agent_name
	tmux_add set-option -p -q -u -t "$target" @agent_path
	tmux_add set-option -p -q -u -t "$target" @agent_project
	tmux_add set-option -p -q -u -t "$target" @agent_session_id
	tmux_flush
}

case "$state" in
	"" | refresh)
		schedule_counts
		exit 0
		;;
	delete)
		[[ -z "$pane_id" ]] || clear_pane_state "$pane_id" || exit 1
		schedule_counts
		exit 0
		;;
	running | waiting | idle | error | init)
		;;
	*)
		schedule_counts
		exit 0
		;;
esac

[[ -z "$pane_id" ]] && exit 0

session_id="$(resolve_session_id)"
session_name="$(tmux display-message -pt "$session_id:" '#{session_name}' 2>/dev/null)"
if [[ "$session_name" == "_popup_all_agents" ]]; then
	exit 0
fi
IFS=$'\x1f' read -r pane_id pane_path start_command current_command enabled prev_state stored_agent stored_path stored_session_id < <(
	tmux display-message -pt "$pane_id" $'#{pane_id}\x1f#{pane_current_path}\x1f#{pane_start_command}\x1f#{pane_current_command}\x1f#{@agent_enabled}\x1f#{@agent_state}\x1f#{@agent_name}\x1f#{@agent_path}\x1f#{@agent_session_id}' 2>/dev/null
)
if [[ -z "$pane_id" || -z "$session_id" || -z "$session_name" ]]; then
	schedule_counts
	exit 0
fi

if [[ "$state" == "init" ]]; then
	[[ "$enabled" == "1" ]] || prev_state=""
	state="${prev_state:-idle}"
fi

case "$state" in
	running | waiting | idle | error) ;;
	*) state="idle" ;;
esac

if ! session_matches "$session_name" agent; then
	[[ "$enabled" != "1" ]] || clear_pane_state "$pane_id" || exit 1
	schedule_counts
	exit 0
fi
agent_status="$(tmux display-message -pt "$session_id" '#{E:TMUX_AGENT_STATUS}' 2>/dev/null)"
agent="$(detect_agent "$start_command" "$current_command")"
if [[ -z "$agent_status" && -z "$agent" ]]; then
	[[ "$enabled" != "1" ]] || clear_pane_state "$pane_id" || exit 1
	schedule_counts
	exit 0
fi
agent="${agent:-${stored_agent:-agent}}"

if [[ "$enabled" == "1" && "$prev_state" == "$state" && "$stored_agent" == "$agent" && "$stored_path" == "$pane_path" && "$stored_session_id" == "$session_id" ]]; then
	exit 0
fi

tmux_begin
tmux_add set-option -p -q -t "$pane_id" @agent_enabled 1
tmux_add set-option -p -q -t "$pane_id" @agent_state "$state"
tmux_add set-option -p -q -t "$pane_id" @agent_name "$agent"
tmux_add set-option -p -q -t "$pane_id" @agent_path "$pane_path"
tmux_add set-option -p -q -t "$pane_id" @agent_session_id "$session_id"
if ! tmux_flush; then
	tmux display-message -pt "$pane_id" '#{pane_id}' >/dev/null 2>&1 || exit 0
	exit 1
fi

schedule_counts
exit 0
