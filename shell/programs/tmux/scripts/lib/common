#!/usr/bin/env bash

project_for_path() {
	local path="$1" root superproject
	case "$path" in
		"~") path="$HOME" ;;
		"~/"*) path="$HOME/${path#"~/"}" ;;
	esac
	if [[ -d "$path" ]]; then
		root="${path%/}"
		[[ -n "$root" ]] || root="/"
		while :; do
			if [[ -f "$root/.root" ]]; then
				printf '%s\n' "$root"
				return
			fi
			[[ "$root" == "/" ]] && break
			root="${root%/*}"
			[[ -n "$root" ]] || root="/"
		done

		root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)"
		while [[ -n "$root" ]]; do
			superproject="$(git -C "$root" rev-parse --show-superproject-working-tree 2>/dev/null)"
			[[ -n "$superproject" ]] || break
			root="$superproject"
		done
		printf '%s\n' "${root:-$path}"
	else
		printf '%s\n' "$path"
	fi
}

# Same normalization as tmux-customize tmcResolveGroup: popup sessions are
# named _popup_<id>_[git_root_|root_]<name>_<encoded-path>.
session_matches() {
	local session="$1" name="$2" logical
	[[ "$session" == "$name" || "$session" == "${name}_"* ]] && return 0
	logical="${session#_popup_}"
	[[ "$logical" == "$session" ]] && return 1
	logical="${logical#*_}"
	logical="${logical#git_root_}"
	logical="${logical#root_}"
	[[ "$logical" == "$name" || "$logical" == "${name}_"* ]]
}

label_for_cmd() {
	local cmd="$1"
	cmd="${cmd%% *}"
	cmd="${cmd##*/}"
	cmd="${cmd#-}"
	printf '%s\n' "${cmd:-shell}"
}

# --- batch tmux IPC helpers -----------------------------------------------
# Accumulate multiple tmux commands and flush them in a single IPC call
# instead of spawning a separate tmux client process for each one.
#
# Usage:
#   tmux_begin                       # start a new batch
#   tmux_add set-option -p ...       # queue a command
#   tmux_add set-option -w ...       # queue another
#   tmux_refresh_clients             # refresh all current clients
#   tmux_flush                       # fire everything in one tmux call
_TMUX_BATCH=()

tmux_lock() {
	local timeout_seconds="${2:-}"
	_TMUX_LOCK="$1"
	if [[ -n "$timeout_seconds" ]]; then
		timeout "$timeout_seconds" tmux wait-for -L "$_TMUX_LOCK" || {
			_TMUX_LOCK=""
			return 1
		}
	else
		tmux wait-for -L "$_TMUX_LOCK" || {
			_TMUX_LOCK=""
			return 1
		}
	fi
	trap tmux_unlock EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
}

tmux_unlock() {
	local lock="${_TMUX_LOCK:-}"
	[[ -n "$lock" ]] || return 0
	tmux wait-for -U "$lock" || return
	_TMUX_LOCK=""
	trap - EXIT HUP INT TERM
}

tmux_begin() {
	_TMUX_BATCH=()
}

tmux_add() {
	((${#_TMUX_BATCH[@]})) && _TMUX_BATCH+=(';')
	_TMUX_BATCH+=("$@")
}

tmux_refresh_clients() {
	local client current error exists
	while IFS= read -r client; do
		[[ -n "$client" ]] || continue
		if error="$(tmux refresh-client -S -t "$client" 2>&1)"; then
			continue
		fi
		exists=""
		while IFS= read -r current; do
			[[ "$current" == "$client" ]] && exists=1
		done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)
		[[ -n "$exists" ]] || continue
		printf '%s\n' "$error" >&2
		return 1
	done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)
}

tmux_flush() {
	local status=0
	((${#_TMUX_BATCH[@]})) || return 0
	tmux "${_TMUX_BATCH[@]}" >/dev/null 2>&1 || status=$?
	_TMUX_BATCH=()
	return "$status"
}
