-        socket_close(sockfd);
+static enum scripting_addition_result scripting_addition_send_bytes(char *bytes, int length)
+{
+    int sockfd;
+    if (!socket_open(&sockfd)) return SA_RESULT_UNAVAILABLE;
+
+    int saved_errno;
+    enum scripting_addition_result result = SA_RESULT_UNAVAILABLE;
+    uint64_t deadline = read_os_timer() + 2 * read_os_freq();
+    if (fcntl(sockfd, F_SETFL, O_NONBLOCK) == -1) goto out;
+
+    if (!socket_connect(sockfd, g_sa_socket_file)) {
+        if (errno != EINPROGRESS && errno != EWOULDBLOCK) goto out;
+        if (!scripting_addition_wait_for_socket(sockfd, POLLOUT, deadline)) goto out;
+
+        int socket_error = 0;
+        socklen_t error_length = sizeof(socket_error);
+        if (getsockopt(sockfd, SOL_SOCKET, SO_ERROR, &socket_error, &error_length) == -1) goto out;
+        if (socket_error) {
+            errno = socket_error;
+            goto out;
+        }
     }
 
+    // A connected request may execute even if its completion cannot be confirmed.
+    result = SA_RESULT_FAILURE;
+    for (int sent = 0; sent < length;) {
+        if (!scripting_addition_wait_for_socket(sockfd, POLLOUT, deadline)) goto out;
+        ssize_t count = send(sockfd, bytes + sent, length - sent, 0);
+        if (count > 0) {
+            sent += (int) count;
+        } else if (count == 0) {
+            errno = EIO;
+            goto out;
+        } else if (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK) {
+            goto out;
+        }
+    }
+
+    for (;;) {
+        if (!scripting_addition_wait_for_socket(sockfd, POLLIN, deadline)) goto out;
+        char reply;
+        ssize_t count = recv(sockfd, &reply, 1, 0);
+        // The payload acknowledges completion by closing the connection.
+        if (count >= 0) {
+            result = SA_RESULT_SUCCESS;
+            break;
+        }
+        if (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK) goto out;
+    }
+
+out:
+    saved_errno = errno;
+    socket_close(sockfd);
+    if (result == SA_RESULT_FAILURE) {
+        warn("yabai: scripting-addition command completion was not confirmed: %s\n", strerror(saved_errno));
+    }
+
     return result;
 }
 
